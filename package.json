{
  "name": "notapedia",
  "private": true,
  "version": "1.0.0",
  "description": "Aplikasi pencatatan PO, Surat Jalan & Invoice — Desktop Offline Windows",
  "author": "Aliester10",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5180 && cross-env VITE_DEV_SERVER_URL=http://localhost:5180 electron .\"",
    "test:services": "node tests/services.test.mjs",
    "test:excel": "node tests/excel.test.mjs",
    "test:excel:e2e": "electron tests/excel-electron.mjs",
    "test:pdf:e2e": "electron tests/pdf-electron.mjs",
    "test:electron": "electron tests/electron-smoke.mjs",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.notapedia.app",
    "productName": "Notapedia",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "icon": "notapedialogo.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
